# Secrets: API keys and Google login files must never be committed
.env
credentials.json
token.json

# Personal data: label suggestions quote subjects from my real emails, and my
# label descriptions name companies I applied to. labels.example.json is shared instead.
labels_proposed.json
labels.json

# The agent's log of every email it handled (senders, subjects, decisions)
inbox_agent.db

# My own sent emails, collected to learn my writing style
style_source_emails.json

# My profile (writing style and facts about me). profile.example/ is shared instead.
profile/

# Which backlog batch is waiting to be applied (local state, deleted after use)
backlog_batch.json

# Settings for testing the web page in the Claude app (its browser pane starts the server)
.claude/

# Downloaded programs, like Tailwind's (112 MB, and GitHub refuses files over 100 MB)
tools/

# The CSS that Tailwind's program builds from the templates (rebuilt, never edited by hand)
web/static/app.css

# Python
.venv/
__pycache__/
*.pyc
